# Cấu hình cổng máy chủ Express API
PORT=3000

# Cấu hình kết nối cơ sở dữ liệu PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitness_db

# Cấu hình trí tuệ nhân tạo (Gemini API & Ollama Local)
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_MODEL=fitness-ai-coach
OLLAMA_BASE_URL=http://localhost:11434
